#include <stdio.h>
int changeRef(int *p){
*p = 100;
return *p;
}
int main(){
int b = 20;
changeRef(&b);
printf("After Call by Reference, b = %d\n"
, b);

return 0;
}


#include <stdio.h>
int change(int x){
x = 50;
return x;
}
int main(){
int a = 10;
change(a);
printf("After Call by Value, a = %d\n"
, a);

return 0;
}



#include <stdio.h>
void swap(int *a, int *b)
{
int temp = *a;
*a = *b;
*b = temp;
}
int main(void)
{
int length = 40, width = 20;
int area;
printf("Before: L=%d, W=%d\n"

, length, width);

area = length * width;
printf("Area = %d sq.cm\n"

, area);

swap(&length, &width);
printf("After: L=%d, W=%d\n"

, length, width);

area = length * width;
printf("Area = %d sq.cm\n"

, area);

return 0;
}
